<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      A bare, fullscreen dark theme. All actual UI is Compose; this only sets the window
      background so there is no flash of white on a television.
    -->
    <style name="Theme.TheContract" parent="@android:style/Theme.DeviceDefault.NoActionBar">
        <item name="android:windowBackground">@color/background</item>
        <item name="android:colorBackground">@color/background</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowActionBar">false</item>
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowContentTransitions">false</item>
    </style>
</resources>
