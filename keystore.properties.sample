# Copy to keystore.properties (git-ignored) and fill in to produce a signed release APK.
# storeFile is resolved relative to the project root.
#
#   keytool -genkeypair -v -keystore the-contract-release.jks \
#           -alias the-contract -keyalg RSA -keysize 4096 -validity 10000
#
storeFile=the-contract-release.jks
storePassword=CHANGE_ME
keyAlias=the-contract
keyPassword=CHANGE_ME
